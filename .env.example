# Production. Copy to .env and fill every required value before starting.
# Publish the application with the supplied release workflow, then use its real
# versioned registry reference (preferably including @sha256:...). No image exists
# at an invented registry address; this must not be a local development tag.
SHOP_APP_IMAGE=
COMPOSE_PROJECT_NAME=kladbutik
SHOP_MODE=production
SHOP_DOMAIN=shop.example.com
# Optional alias; its DNS must also point here and its certificate must cover it.
SHOP_WWW_DOMAIN=
SHOP_URL=https://shop.example.com
SHOP_ADMIN_USER=shopadmin
SHOP_ADMIN_EMAIL=
SHOP_HTTP_BIND=0.0.0.0
SHOP_HTTP_PORT=80
SHOP_HTTPS_BIND=0.0.0.0
SHOP_HTTPS_PORT=443
SHOP_PROXY_SUBNET=172.30.72.0/24
SHOP_PROXY_DYNAMIC_RANGE=172.30.72.128/25
SHOP_PROXY_IP=172.30.72.2
SHOP_DB_NAME=shop
SHOP_DB_USER=shop
SHOP_DB_PASSWORD_PATH=./secrets/db_password
SHOP_DB_ROOT_PASSWORD_PATH=./secrets/db_root_password
SHOP_ADMIN_PASSWORD_PATH=./secrets/admin_password
SHOP_SECRET_PATH=./secrets/shop_secret
ACME_EMAIL=
# Use staging only for a rehearsal. Its certificates are not browser-trusted.
# Use a fresh certificates volume before subsequently requesting a live cert.
ACME_STAGING=0
SHOP_SMTP_HOST=
SHOP_SMTP_PORT=587
SHOP_SMTP_USER=
SHOP_SMTP_FROM=
# Checkout stays server-disabled in this baseline until the complete launch gate
# and external payment/mail integrations have been implemented and verified.
