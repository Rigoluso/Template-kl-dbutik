# Local HTTP demonstration; generate secret files before the first start.
SHOP_APP_IMAGE=shop-template:0.1.0
COMPOSE_PROJECT_NAME=kladbutik-demo
SHOP_MODE=demo
SHOP_DOMAIN=localhost
SHOP_WWW_DOMAIN=
SHOP_URL=http://localhost:18080
SHOP_ADMIN_USER=shopadmin
SHOP_ADMIN_EMAIL=admin@example.test
SHOP_HTTP_BIND=127.0.0.1
SHOP_HTTP_PORT=18080
SHOP_HTTPS_BIND=127.0.0.1
SHOP_HTTPS_PORT=18443
SHOP_PROXY_SUBNET=172.30.72.0/24
SHOP_PROXY_DYNAMIC_RANGE=172.30.72.128/25
SHOP_PROXY_IP=172.30.72.2
SHOP_DB_NAME=shop
SHOP_DB_USER=shop
SHOP_DB_PASSWORD_PATH=./secrets/db_password
SHOP_DB_ROOT_PASSWORD_PATH=./secrets/db_root_password
SHOP_ADMIN_PASSWORD_PATH=./secrets/admin_password
SHOP_SECRET_PATH=./secrets/shop_secret
ACME_EMAIL=
ACME_STAGING=1
